# Variables de entorno necesarias para correr el backend localmente.
# Este archivo es solo referencia: NO pongas valores reales aquí ni lo renombres a .env y lo subas al repo.
# Cada persona configura sus propios valores en su IDE (IntelliJ: Run > Edit Configurations > Environment variables)
# o exportándolas en su terminal antes de correr ./mvnw spring-boot:run.

# Contraseña de tu usuario de Postgres local
DB_PASSWORD=

# Credenciales de la cuenta de Gmail usada para enviar correos (pide los valores reales por un canal aparte, nunca por git)
MAIL_USERNAME=
MAIL_PASSWORD=

# Secreto para firmar los JWT (puede ser cualquier string largo y aleatorio en desarrollo local)
JWT_SECRET=

# --- Solo producción (Render): se configuran en el panel de Render, nunca en git ---
# Supabase (Session pooler): jdbc:postgresql://<host>:5432/postgres
DB_URL=
DB_USERNAME=
# URL pública del frontend (enlaces de correos) y origen permitido por CORS
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
# URL pública del backend + /uploads
UPLOADS_BASE_URL=
# Credenciales del super admin sembrado en el primer arranque
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SHOW_SQL=false
